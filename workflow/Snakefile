import pandas as pd
import os

configfile: "config/config.yaml"

print("Snakefile loaded.")

# --- Sample Sheet Parsing ---
try:
    SAMPLE_SHEET = pd.read_csv(config["sample_sheet"], sep='\t').set_index("sample_id", drop=False)
    SAMPLE_IDS = SAMPLE_SHEET.index.tolist()
    print(f"Successfully loaded sample sheet. Sample IDs: {SAMPLE_IDS}")
    expected_columns = {"sample_id", "type", "fq1", "fq2", "sra_accession"}
    if not expected_columns.issubset(SAMPLE_SHEET.columns):
        missing_cols = expected_columns - set(SAMPLE_SHEET.columns)
        raise ValueError(f"Sample sheet is missing required columns: {missing_cols}")
except FileNotFoundError:
    print(f"Error: Sample sheet '{config['sample_sheet']}' not found. Please create it.")
    SAMPLE_IDS = []
except Exception as e:
    print(f"Error loading or parsing sample sheet: {e}")
    SAMPLE_IDS = []
# --- End Sample Sheet Parsing ---


# --- Helper functions for input determination ---
def get_fastq1(wildcards):
    sample_info = SAMPLE_SHEET.loc[wildcards.sample_id]
    if pd.notna(sample_info.get("sra_accession")) and str(sample_info["sra_accession"]).strip() != "":
        return os.path.join(config["sra_download_dir"], wildcards.sample_id, f"{wildcards.sample_id}_1.fastq.gz")
    elif pd.notna(sample_info.get("fq1")):
        return sample_info["fq1"]
    else:
        raise ValueError(f"Sample {wildcards.sample_id} has no valid sra_accession or fq1 defined.")

def get_fastq2(wildcards):
    sample_info = SAMPLE_SHEET.loc[wildcards.sample_id]
    if sample_info["type"].upper() == "PAIRED":
        if pd.notna(sample_info.get("sra_accession")) and str(sample_info["sra_accession"]).strip() != "":
            return os.path.join(config["sra_download_dir"], wildcards.sample_id, f"{wildcards.sample_id}_2.fastq.gz")
        elif pd.notna(sample_info.get("fq2")):
            return sample_info["fq2"]
        else:
            raise ValueError(f"Paired-end sample {wildcards.sample_id} has no valid sra_accession or fq2 defined.")
    return []

def get_hisat2_layout_opts(wildcards, input):
    sample_info = SAMPLE_SHEET.loc[wildcards.sample_id]
    if sample_info["type"].upper() == "PAIRED":
        if not input.fq2:
             raise ValueError(f"Missing fq2 for paired-end sample {wildcards.sample_id}")
        return f"-1 {input.fq1} -2 {input.fq2}"
    else:
        return f"-U {input.fq1}"

# --- Function to get track names for expand ---
def get_track_names(config_feature_tracks):
    if isinstance(config_feature_tracks, list): # check if feature_tracks is a list
        return [track["name"] for track in config_feature_tracks if isinstance(track, dict) and "name" in track]
    return []
# --- End Helper Functions ---

# --- Determine Final Targets for Rule All ---
FINAL_TARGETS = [
    config["genome_dir"] + "/genome.fa",
    config["genome_dir"] + "/genome.gtf",
    config["sra_info_csv"],
    config["splice_sites_file"],
    directory(config["hisat2_index_dir"]),
    config["merged_gtf_dir"] + "/" + config["merged_gtf_name"],
    config["merged_gtf_dir"] + "/" + config["merged_new_transcripts_gtf_name"],
    config["merged_gtf_dir"] + "/" + config["merged_transcripts_fasta_name"],
    config["merged_gtf_dir"] + "/" + config["merged_new_transcripts_fasta_name"],
    config["comparison_dir"] + "/cuffcomp.combined.gtf",
    config["cpat_dir"] + "/cpat.ORF_prob.best.tsv",
    config["final_non_coding_gtf"],
    config["final_coding_gtf"],
    config["final_feature_table_csv"], # Added feature table
]
if SAMPLE_IDS:
    FINAL_TARGETS.extend(expand(config["mapping_dir"] + "/{sample_id}/{sample_id}.sorted.bam", sample_id=SAMPLE_IDS))
    FINAL_TARGETS.extend(expand(config["mapping_dir"] + "/{sample_id}/{sample_id}.sorted.bam.bai", sample_id=SAMPLE_IDS))
    FINAL_TARGETS.extend(expand(directory(config["ballgown_input_dir"] + "/{sample_id}"), sample_id=SAMPLE_IDS))

if config.get("metadata_file") and str(config.get("metadata_file")).strip() not in [None, "None", "null", ""]:
    print(f"Metadata file provided ({config['metadata_file']}), adding DGE targets to rule all.")
    FINAL_TARGETS.extend([
        os.path.join(config["dge_dir"], config["dge_transcripts_file"]),
        os.path.join(config["dge_dir"], config["transcript_expressions_file"]),
    ])
else:
    print("No metadata file provided. Skipping DGE targets.")


rule all:
    input: FINAL_TARGETS


# --- CPAT Model Download ---
rule download_cpat_models:
    output:
        hexamer = config["cpat_hexamer_file"],
        logit_model = config["cpat_logit_model_file"],
        cutoff = config["cpat_cutoff_file"]
    params:
        model_dir = os.path.dirname(config["cpat_hexamer_file"]),
        hex_url = "https://sourceforge.net/projects/cpat/files/v1.2.2/CPAT_v1.2.2_standalone/Dm_Hexamer.tsv/download",
        logit_url = "https://sourceforge.net/projects/cpat/files/v1.2.2/CPAT_v1.2.2_standalone/Dm_logitModel.RData/download",
        cutoff_val = "0.364"
    shell:
        "mkdir -p {params.model_dir} && "
        " (wget -q -O {output.hexamer} {params.hex_url} || echo 'Failed to download hexamer model, placeholder created.' > {output.hexamer}) && "
        " (wget -q -O {output.logit_model} {params.logit_url} || echo 'Failed to download logit model, placeholder created.' > {output.logit_model}) && "
        " echo '{params.cutoff_val}' > {output.cutoff}"

